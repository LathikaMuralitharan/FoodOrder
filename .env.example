# ==============================================================================
# Amazon Bedrock Configuration (Server-Side Only)
# ==============================================================================
# DO NOT COMMIT SENSITIVE VALUES TO GITHUB / VERSION CONTROL
# Copy this file to .env and provide your valid credentials to enable live Bedrock.
# If these environment variables are absent, the application automatically uses
# the safe mock/demo assistant fallback without making any AWS network calls.

# AWS Region where your Bedrock model access is enabled (e.g. us-east-1, us-west-2)
AWS_REGION=us-east-1

# IAM Credentials with least-privilege bedrock:InvokeModel permissions
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# (Optional) AWS Session Token if using temporary credentials or AWS SSO
# AWS_SESSION_TOKEN=

# Model ID for Amazon Bedrock Converse API:
# Recommended models:
# - anthropic.claude-3-haiku-20240307-v1:0 (Fastest, low cost, excellent food reasoning)
# - amazon.nova-micro-v1:0
# - amazon.nova-lite-v1:0
# - meta.llama3-8b-instruct-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Rate limiting for AI assistant (max requests per minute per IP)
BEDROCK_RATE_LIMIT_PER_MINUTE=20
